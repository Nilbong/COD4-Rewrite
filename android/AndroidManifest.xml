<?xml version="1.0" encoding="utf-8"?>
<!-- The CoD4 rewrite on Android: one NativeActivity running libcod4rw.so. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cod4rewrite.game"
    android:versionCode="1"
    android:versionName="0.4.0-android-poc">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33" />

    <!-- Vulkan 1.1 (Bevy's wgpu backend). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Online matches (relay) and server browsing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reading a copy of CoD4 elsewhere on shared storage (e.g. Download/Call of Duty 4). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:label="CoD4 Rewrite"
        android:icon="@mipmap/icon"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:isGame="true"
        android:appCategory="game">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="cod4rw" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
